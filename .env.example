# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5445/extraction

# --- Auth: bearer token for every endpoint except /health ---
API_KEY=change-me-to-a-long-random-api-key-32-chars-min

# --- Storage (StorageProvider): local | s3 ---
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=

# --- LLM (LLMProvider): fake | anthropic | bedrock ---
LLM_PROVIDER=fake
# anthropic: credentials come from ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
BEDROCK_LLM_MODEL=anthropic.claude-opus-5-5
BEDROCK_FALLBACK_MODEL=anthropic.claude-opus-4-8
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000

# --- Documents ---
MAX_UPLOAD_BYTES=5000000
MAX_DOCUMENT_CHARS=50000
